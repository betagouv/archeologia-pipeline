#!/usr/bin/env sh
set -eu

# Python et ruff : ceux de .venv_dev (pytest, xdist, ruff) s'il existe, sinon le PATH.
if [ -x ".venv_dev/Scripts/python.exe" ]; then PY=".venv_dev/Scripts/python.exe"
elif command -v python >/dev/null 2>&1; then PY=python
else PY=python3; fi
if [ -x ".venv_dev/Scripts/ruff.exe" ]; then RUFF=".venv_dev/Scripts/ruff.exe"; else RUFF=ruff; fi

# Lint (AUDIT v2 HYG-01, étendu à tests/ et dev/ le 2026-10-20) : refuse le push si ruff
# trouve des erreurs. `set -eu` fait échouer le hook sur un ruff non vert.
if [ "$RUFF" != ruff ] || command -v ruff >/dev/null 2>&1; then
  echo "[ruff] check src/ tests/ dev/ ..."
  "$RUFF" check src/ tests/ dev/
else
  echo "[ruff] WARNING: 'ruff' introuvable dans le PATH - lint ignoré."
fi

# Suite de tests (2026-10-20) : en parallèle (pytest-xdist). Dans le dossier principal
# (.git est un dossier ; dans un worktree c'est un fichier), modèles, binaire, vignettes
# et grille sont là : un test qui sauterait faute d'eux y cacherait une régression,
# ARCHEO_EXIGER_DONNEES=1 le rend rouge (fixture exiger_ou_sauter de tests/conftest.py).
# ARCHEO_EXIGER_DONNEES=0 git push … pour passer outre, en connaissance de cause.
if [ -d .git ] && [ -z "${ARCHEO_EXIGER_DONNEES+x}" ]; then
  export ARCHEO_EXIGER_DONNEES=1
fi
echo "[tests] run_tests.py -q (ARCHEO_EXIGER_DONNEES=${ARCHEO_EXIGER_DONNEES-}) ..."
"$PY" run_tests.py -q

# Validateur des modèles installés (audit 2026-08-31) : data/models est
# gitignoré mais les métadonnées mensongères se propagent aux ZIP livrés —
# les ERR bloquent le push (les WARN legacy passent ; --strict = à la main).
if [ -d "data/models" ] && ls data/models/*/weights >/dev/null 2>&1; then
  echo "[modeles] validate_models_metadata ..."
  "$PY" scripts/validate_models_metadata.py
fi

# Talisman pre-push hook.
# Requires 'talisman' to be available in PATH.

if ! command -v talisman >/dev/null 2>&1; then
  echo "[talisman] ERROR: 'talisman' not found in PATH."
  echo "[talisman] Install it, or disable hooksPath if you really must push without scanning."
  exit 1
fi

# Run the official talisman githook mode.
# It will scan what is being pushed and block on potential secrets.
talisman --githook pre-push "$@"
